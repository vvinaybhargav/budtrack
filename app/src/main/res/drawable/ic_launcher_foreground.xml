<!--
  Three rising bars — a household's month getting bigger, or smaller.

  Drawn as round-capped strokes rather than filled shapes so the ends stay
  rounded at every density, and kept inside the adaptive icon's safe zone (the
  centre 66dp of 108dp) so no launcher mask clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M36,72 V60"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="11"
        android:strokeLineCap="round" />
    <path
        android:pathData="M54,72 V49"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="11"
        android:strokeLineCap="round" />
    <path
        android:pathData="M72,72 V38"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:strokeAlpha="0.65" />
</vector>
